---
import Tag from "./Tag.astro";
const base = import.meta.env.BASE_URL;

const { script } = Astro.props;
---
<div class="card">
    <h2><a href=`${base}/scripts/${script.id}`>{script.data.title}</a></h2>
    <div class="tags">{script.data.tags.map((tag: string) =>(
        <Tag {tag}/>
    ))}</div>

    <p>{script.data.description}</p>
</div>

<style>
    .card{
        padding: 1rem;
        max-width: 350px;
        border-radius: 5px;
        box-shadow: 2px 2px 5px rgba(0,0,0,0.25);
    }
    .card>h2{
        margin: 0 0 10px 0;
    }

    .tags{
        display: flex;
        flex-wrap: wrap;
    }
</style>