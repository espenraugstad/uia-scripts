---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/uia-scripts/favicon.svg" />
		<link rel="icon" href="/uia-scripts/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>UiA Scripts</title>
	</head>
	<body>
        <Nav></Nav>
        <slot />
		<Footer></Footer>
	</body>
	<style>
		body{
			min-height: 100vh;
			display: grid;
			grid-template-rows: auto 1fr auto;
		}
	</style>
</html>